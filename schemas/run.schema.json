{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/paceghost/main/schemas/run.schema.json",
  "title": "Paceghost Recorded Run (v1)",
  "description": "Version 1 recorded agent run read by show, ghost, race, and board.",
  "type": "object",
  "required": [
    "task",
    "window_seconds",
    "runner",
    "recorded_at",
    "splits"
  ],
  "dependentRequired": {
    "reads": [
      "usage",
      "budget"
    ]
  },
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "window_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "total_seconds": {
      "type": "number",
      "minimum": 0
    },
    "usage": {
      "type": "number",
      "minimum": 0
    },
    "budget": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "elapsed_seconds"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "reads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "elapsed_seconds",
          "usage"
        ],
        "properties": {
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "usage": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
