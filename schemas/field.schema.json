{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/paceghost/main/schemas/field.schema.json",
  "title": "Paceghost Season Field (v1)",
  "description": "Version 1 multi-run season field read by paceghost season.",
  "type": "object",
  "required": [
    "runs"
  ],
  "properties": {
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "run.schema.json"
          },
          {
            "required": [
              "model",
              "usage",
              "budget"
            ]
          }
        ]
      }
    }
  }
}
