{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/paceghost/main/schemas/field-day.schema.json",
  "title": "Paceghost Field Day (v1)",
  "description": "Version 1 single-window competitive field day read by paceghost fieldday.",
  "type": "object",
  "required": [
    "window_seconds",
    "operator",
    "runs"
  ],
  "properties": {
    "window_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runner"
        ],
        "dependentRequired": {
          "reads": [
            "usage"
          ]
        },
        "properties": {
          "runner": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "usage": {
            "type": "number",
            "minimum": 0
          },
          "reads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "elapsed_seconds",
                "usage"
              ],
              "properties": {
                "elapsed_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "usage": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
